# ─────────────────────────────────────────────────────────────
# LUMIA — Variables d'environnement (exemple)
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Tous les champs sont OPTIONNELS tant que le backend n'est pas branché.
# ─────────────────────────────────────────────────────────────

# URL publique du site (utilisée pour les metadata / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://lumia-maison.fr

# Resend — envoi des e-mails de formulaire (https://resend.com)
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=contact@lumia-maison.fr

# Supabase — stockage des prospects / liste d'attente (https://supabase.com)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# SUPABASE_SERVICE_ROLE_KEY=xxx

# Stripe — acomptes anniversaire & cartes cadeaux (https://stripe.com)
# STRIPE_SECRET_KEY=sk_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx

# Calendly — réservation de créneaux (optionnel)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/lumia
